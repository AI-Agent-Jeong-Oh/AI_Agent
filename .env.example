# This file documents names only. The app does not auto-load .env files.
# Never put a real key in this repository.

# Optional media tool paths. Homebrew defaults are discovered automatically.
VIDEO_AGENT_FFPROBE=
VIDEO_AGENT_FFMPEG=

# Local Ollama-compatible VLM. The app auto-detects /api/show vision capability.
# The model is not downloaded automatically. Recommended development model:
# qwen3-vl:4b-instruct
VIDEO_AGENT_LOCAL_PROVIDER=ollama-local
VIDEO_AGENT_LOCAL_ENDPOINT=http://127.0.0.1:11434/api/chat
VIDEO_AGENT_LOCAL_PROTOCOL=ollama_native
VIDEO_AGENT_LOCAL_MODEL=
VIDEO_AGENT_LOCAL_MODEL_SUPPORTS_VISION=false

# External VLM. HTTPS, analysis approval, and separate transfer approval are required.
VIDEO_AGENT_EXTERNAL_PROVIDER=openai
VIDEO_AGENT_EXTERNAL_ENDPOINT=https://api.openai.com/v1/chat/completions
VIDEO_AGENT_EXTERNAL_PROTOCOL=openai_chat_completions
VIDEO_AGENT_EXTERNAL_MODEL=
VIDEO_AGENT_EXTERNAL_MODEL_SUPPORTS_VISION=false
VIDEO_AGENT_EXTERNAL_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY is intentionally not assigned here.

# Optional user storage overrides, useful for isolated development tests.
VIDEO_AGENT_DATA_DIR=
VIDEO_AGENT_CACHE_DIR=
